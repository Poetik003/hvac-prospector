# LIVE CALLING CONFIGURATION - ENABLED
LIVE_CALLING_ENABLED=true
CALLING_SERVICE=webhook
WEBHOOK_URL=https://api.realcalls.com/make-call
DEMO_MODE=false
REAL_CALLS_ENABLED=true

# TWILIO CREDENTIALS (Replace with real credentials for Twilio calling)
TWILIO_ACCOUNT_SID=AC_your_real_account_sid_here
TWILIO_AUTH_TOKEN=your_real_auth_token_here  
TWILIO_FROM_NUMBER=+1your_twilio_phone_number

# CALL SETTINGS
DEFAULT_CALLER_ID=HVAC Services
CALL_TIMEOUT=30
RECORD_CALLS=true
ENABLE_VOICEMAIL_DETECTION=true
